@inject NavigationManager NavigationManager
@inject IThemeService ThemeService

<nav class="nav-menu">
    <div class="brand">
        Journal
    </div>

    <div class="nav-section">
        <NavLink href="" Match="NavLinkMatch.All" class="nav-link">
            🏠 Home
        </NavLink>

        <NavLink href="calendar" class="nav-link">
            📅 Views
        </NavLink>

        <NavLink href="journal" class="nav-link">
            ✍️ Journal
        </NavLink>
    </div>

    <div class="nav-footer">
        <button class="nav-link theme-toggle" @onclick="ToggleTheme">
            @(isDarkMode ? "🌙 Dark" : "☀️ Light")
        </button>
    </div>
</nav>

@code {
    private bool isDarkMode;

    protected override async Task OnInitializedAsync()
    {
        isDarkMode = await ThemeService.IsDarkMode();
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleTheme();
        isDarkMode = await ThemeService.IsDarkMode();
    }
}
